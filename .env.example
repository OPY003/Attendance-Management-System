# Universal Attendance & Presence Management System (UAPMS) Configuration
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=sqlite://./uapms.sqlite
# For PostgreSQL in production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uapms?sslmode=disable

# Authentication & Security
JWT_SECRET=uapms_super_secure_jwt_secret_key_change_in_production_min_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=uapms_super_secure_refresh_secret_key_change_in_production_min_32
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_HASH_ROUNDS=12
MFA_ISSUER=UAPMS

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Notifications (Email / SMS / Webhooks)
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@uapms.io
SMTP_HOST=localhost
SMTP_PORT=1025
SMS_PROVIDER=mock
PUSH_PROVIDER=mock

# Geolocation / Maps
GEOLOCATION_TOLERANCE_METERS=15

# Audit & Retention
AUDIT_RETENTION_DAYS=365
ATTENDANCE_EVENT_RETENTION_DAYS=730
